# npm run deploy generates .env and a random database password automatically.
APP_PORT=3210
POSTGRES_PASSWORD=replace-with-a-long-random-password
COOKIE_SECURE=false
# For local npm development only; Docker supplies DATABASE_URL automatically.
# DATABASE_URL=postgresql://xinyu:your-password@localhost:your-db-port/xinyu
# Set true when publishing behind an HTTPS reverse proxy.
# COOKIE_SECURE=true
# Configure an independent TURN service for networks that cannot connect directly.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
